# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
# In production, set each secret with: npx wrangler secret put <NAME>
GEMINI_API_KEY=your-google-ai-studio-key
GROQ_API_KEY=your-groq-key
IP_SALT=a-long-random-string-from-openssl-rand-hex-32

# Dev only: vars here override wrangler.toml [vars] locally.
ALLOWED_ORIGINS=http://localhost:3000

# Print every pipeline step in the `npm run dev` terminal. Local only.
JO_DEBUG=true

# Looser per-IP limits for local testing (production: bucket of 15, refills every 6s, 150 a day).
PER_IP_BURST=200
PER_IP_DAILY=1000

# Opens the private usage page (/usage). In production: npx wrangler secret put ADMIN_TOKEN
ADMIN_TOKEN=a-long-random-string
